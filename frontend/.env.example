# Copiá este archivo como .env para desarrollo local.
# .env está ignorado por git a propósito: Vite hornea estos valores dentro del
# bundle al buildear, así que si se versiona con valores de localhost, esos
# valores terminan en producción.
#
# En producción, VITE_API_URL sale del panel de Vercel (Settings → Environment
# Variables) y VITE_SITE_URL de .env.production.

VITE_API_URL=http://localhost:8080/api
VITE_SITE_URL=http://localhost:5173
